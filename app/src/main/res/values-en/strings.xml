    <!-- Assessment -->
    <string name="assess_title">Training ability check-in</string>
    <string name="assess_intro">The check-in is optional. It helps you see which level fits you now. The result is only a suggestion and never locks your level.</string>
    <string name="assess_step_of">Step %1$d of 5</string>
    <string name="assess_control_title">1/5 Muscle control</string>
    <string name="assess_control_body">Find the muscles you would use to hold back gas or stop urine flow. Tighten inward and upward. Breathe normally; don\'t clench your buttocks or thighs, and don\'t hold your breath.</string>
    <string name="assess_control_q">How does it feel?</string>
    <string name="assess_control_clear">I can find them clearly</string>
    <string name="assess_control_unsure">Not sure</string>
    <string name="assess_control_compensating">I clearly rely on other muscles</string>
    <string name="assess_seconds_title">2/5 Endurance hold seconds</string>
    <string name="assess_seconds_body">Tap Start timer and hold while following the seconds, up to 10 s. When the contraction clearly fades or you can\'t hold, tap Stop and the seconds you actually held are recorded.</string>
    <string name="assess_reps_title">3/5 Endurance reps</string>
    <string name="assess_reps_body">Each rep: tap Start this rep, then tighten and hold for the seconds you just measured following the countdown. After it ends you rest, and the rest is counted down too — when it ends the next rep starts automatically, no tap needed. Up to 10 reps.</string>
    <string name="assess_fast_title">4/5 Quick reps</string>
    <string name="assess_fast_body">Quick tighten, then relax fully right away. Pick how many you did in one go — no need to tap once per rep.</string>
