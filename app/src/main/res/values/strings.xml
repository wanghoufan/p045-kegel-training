    <!-- 摸底 -->
    <string name="assess_title">训练能力摸底</string>
    <string name="assess_intro">摸底可选，用来了解自己现在适合从哪一级开始。结果只作建议，不会锁住你的等级。</string>
    <string name="assess_step_of">第 %1$d / 5 项</string>
    <string name="assess_control_title">1/5 动作控制</string>
    <string name="assess_control_body">像忍住排气、控制排尿时那组内部肌肉，向内、向上收紧；正常呼吸，不明显夹臀、不夹腿、不憋气。</string>
    <string name="assess_control_q">你现在的感觉是？</string>
    <string name="assess_control_clear">能较清楚识别</string>
    <string name="assess_control_unsure">不确定</string>
    <string name="assess_control_compensating">明显依赖其他肌群</string>
    <string name="assess_seconds_title">2/5 耐力保持秒数</string>
    <string name="assess_seconds_body">点「开始计时」，跟着秒数收紧并保持；最长 10 秒。感觉收缩明显衰减或撑不住，就点「停」，会记录你实际保持的秒数。</string>
    <string name="assess_reps_title">3/5 耐力次数</string>
    <string name="assess_reps_body">每轮先点「开始本次」，跟着倒计时按刚测的秒数收紧并保持；结束后放松休息，休息同样会倒计时，数完自动进入下一轮，不用手动点击。最多 10 次。</string>
    <string name="assess_fast_title">4/5 快速次数</string>
    <string name="assess_fast_body">快速收紧 → 立即完全放松。一次性选择你完成的次数即可，不用逐次点击。</string>
    <string name="assess_hold_start">开始计时</string>
    <string name="assess_hold_stop">撑不住了，停</string>
    <string name="assess_hold_retry">重新测</string>
    <string name="assess_hold_running">收紧并保持，跟着秒数走…</string>
    <string name="assess_hold_recorded">已记录：保持 %1$d 秒</string>
    <string name="assess_reps_start">开始本次（收紧并保持 %1$d 秒）</string>
